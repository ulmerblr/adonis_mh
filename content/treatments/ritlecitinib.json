  "sections": {
    "what": [
      {
        "t": "p",
        "text": "Ritlecitinib is a kinase inhibitor taken by mouth. It irreversibly blocks JAK3 and the TEC family of kinases, which relay immune signals. How this relates to its effect is not known.",
        "src": [
          {
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=6b2f9446-fb23-4741-b73a-5a2f993733c3",
            "label": "Litfulo label, DailyMed",
            "date": "published Jun 2026"
          }
        ]
      },
      {
        "t": "p",
        "text": "It treats alopecia areata, an autoimmune disease in which the immune system attacks hair follicles. It is not a treatment for male pattern hair loss.",
        "src": [
          {
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=6b2f9446-fb23-4741-b73a-5a2f993733c3",
            "label": "Litfulo label, DailyMed",
            "date": "published Jun 2026"
          },
          {
            "url": "https://www.ema.europa.eu/en/medicines/human/EPAR/litfulo",
            "label": "EMA, Litfulo EPAR overview",
            "date": "accessed Nov 1, 2026"
          }
        ]
      }
    ],
    "research": [
      {
        "t": "lead",
        "text": "Approval rests mainly on one Phase 2b/3 trial, ALLEGRO-2b/3, in 718 people aged 12 and older with at least 50% scalp hair loss, run by Pfizer, the maker."
      },
      {
        "t": "h3",
        "text": "Human studies"
      },
      {
        "t": "study",
        "meta": "18 countries · 2023 · Randomized Phase IIb/III",
        "title": "ALLEGRO-2b/3 (King et al.)",
        "facts": [
          {
            "k": "Design",
            "v": "randomized, double-blind, placebo-controlled Phase 2b/3 trial at 118 sites"
          },
          {
            "k": "People",
            "v": "718 people aged 12 and older with alopecia areata and at least 50% scalp hair loss; 105 were 12 to 17"
          },
          {
            "k": "What was given",
            "v": "ritlecitinib 10, 30 or 50 mg a day, with or without a 200 mg loading dose for 4 weeks, or placebo; placebo groups switched to ritlecitinib after 24 weeks"
          },
          {
            "k": "Length",
            "v": "24 weeks placebo-controlled, then a 24-week extension"
          },
          {
            "k": "Measured",
            "v": "share with SALT 20 or less (80% or more scalp hair) at week 24"
          }
        ],
        "found": "At week 24, 23% on 50 mg (the approved dose) reached SALT 20 or less vs 2% on placebo. With a 200 mg loading dose then 50 mg, 31% did. Adverse events were similar between groups, and there were no deaths. Funded by Pfizer.",
        "src": [
          {
            "url": "https://pubmed.ncbi.nlm.nih.gov/37062298/",
            "label": "King et al., Lancet (ALLEGRO-2b/3)",
            "date": "published May 2023"
          },
          {
            "url": "https://clinicaltrials.gov/study/NCT03732807",
            "label": "ClinicalTrials.gov, ALLEGRO-2b/3 (NCT03732807)",
            "date": "accessed Nov 1, 2026"
          },
          {
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=6b2f9446-fb23-4741-b73a-5a2f993733c3",
            "label": "Litfulo label, DailyMed",
            "date": "published Jun 2026"
          }
        ]
      },
      {
        "t": "study",
        "meta": "Multicenter · 2021 · Randomized Phase IIa",
        "title": "Ritlecitinib and brepocitinib (King et al.)",
        "facts": [
          {
            "k": "Design",
            "v": "randomized, placebo-controlled Phase 2a trial"
          },
          {
            "k": "People",
            "v": "142 adults with at least 50% scalp hair loss: 48 on ritlecitinib, 47 on brepocitinib, 47 on placebo"
          },
          {
            "k": "Length",
            "v": "24 weeks"
          },
          {
            "k": "Measured",
            "v": "change in SALT score; share with at least 30% improvement"
          }
        ],
        "found": "SALT score improved more on ritlecitinib than placebo (difference 31.1 points). 50% on ritlecitinib reached a 30% improvement vs 2% on placebo.",
        "src": [
          {
            "url": "https://pubmed.ncbi.nlm.nih.gov/33757798/",
            "label": "King et al., J Am Acad Dermatol (Phase 2a)",
            "date": "published Aug 2021"
          }
        ]
      },
      {
        "t": "h3",
        "text": "Animal and lab studies"
      },
      {
        "t": "p",
        "text": "In dogs given ritlecitinib for many months at high doses, reversible hearing loss and changes in hearing nerve tests appeared. They were not seen at lower doses. The cause was not identified.",
        "src": [
          {
            "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=6b2f9446-fb23-4741-b73a-5a2f993733c3",
            "label": "Litfulo label, DailyMed",
            "date": "published Jun 2026"
          }
        ]
      }
    ],
